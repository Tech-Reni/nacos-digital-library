# .htaccess

# Disable directory listing globally
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep the public production site and submitted credentials on HTTPS.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # The production app is served at the domain root; preserve old cached links.
    RewriteRule ^nacos-app/(.*)$ /$1 [R=301,L,NE]

    # Prevent direct URL access to includes directory
    RewriteRule ^includes/(.*)$ -

    # Prevent direct URL access to the protected PDFs folder (Anti-Download)
    RewriteRule ^uploads/protected_books/(.*)$ -

    # Prevent access to temp upload files
    RewriteRule ^upload/temp/(.*)$ -
</IfModule>

<IfModule mod_headers.c>
    # HSTS is sent only after a secure request; do not pin local HTTP development.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>